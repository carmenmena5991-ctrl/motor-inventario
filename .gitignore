!/data/**/*.dvc
/models/*
!/models/.gitkeep
!/models/*.dvc
*.csv
*.db
*.joblib
!*.dvc

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env

